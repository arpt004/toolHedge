# PostgreSQL connection used by Prisma and the API
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/toolhedge?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=toolhedge

# API server
API_PORT=4000
API_URL=http://localhost:4000/api/v1
CORS_ORIGIN=http://localhost:5173
SHOW_DEMO_DATA=false

# Admin auth — set your own long random value in production (e.g. `openssl
# rand -hex 32`). Session tokens are HMAC'd with this secret before being
# stored, so it must stay secret and stable (rotating it invalidates every
# existing admin session).
ADMIN_SESSION_SECRET=dev-only-insecure-secret-change-me
ADMIN_SESSION_TTL_HOURS=12

# Frontend API base URL
VITE_API_URL=http://localhost:4000/api/v1
